{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catalog-engine",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "catalog-engine-db",
      "database_id": "12ac414c-4aef-4668-a8f9-dc63d57d449f",
      "migrations_dir": "migrations"
    }
  ]
}
