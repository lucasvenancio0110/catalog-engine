{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catalog-engine",
  "main": "./worker/entry-publish.js",
  "compatibility_date": "2026-08-17",
  "vars": {
    "CATALOG_PLATFORM_HOSTS": "catalog-engine.lucassantanals0110.workers.dev,catalogoengine.com,app.catalogoengine.com",
    "CATALOG_ADMIN_HOST": "app.catalogoengine.com",
    "TENANT_IMPORT_AUTOMATION_ENABLED": "0"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*"
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "catalog-engine-db",
      "database_id": "12ac414c-4aef-4668-a8f9-dc63d57d449f",
      "migrations_dir": "migrations"
    }
  ],
  "dispatch_namespaces": [
    {
      "binding": "TENANT_DISPATCH",
      "namespace": "catalog-engine-production"
    }
  ]
}
