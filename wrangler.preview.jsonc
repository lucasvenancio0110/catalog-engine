{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catalog-engine-ui-preview",
  "main": "./worker/entry-ui-preview.js",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*"
    ]
  },
  "observability": {
    "enabled": true
  }
}
