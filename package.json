{
  "name": "catalog-engine",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "scrape": "node scripts/scrape-yupoo.mjs",
    "crawl": "node scripts/crawl-entry.mjs",
    "crawl:core": "node scripts/crawl-yupoo.mjs",
    "taxonomy:enrich": "node scripts/enrich-taxonomy.mjs",
    "media:optimize": "node scripts/media-pipeline.mjs",
    "audit": "node scripts/quality-audit.mjs",
    "sync:audit": "node scripts/sync-audit.mjs",
    "sync:incremental:scan": "node scripts/scan-yupoo-listing-index.mjs",
    "sync:incremental:plan": "node scripts/plan-yupoo-incremental.mjs",
    "sync:incremental:apply": "node scripts/process-yupoo-delta.mjs",
    "tenant:plan": "node scripts/provision-tenant-plan.mjs",
    "tenant:source:connect": "node scripts/connect-tenant-source.mjs",
    "taxonomy:audit": "node scripts/taxonomy-audit.mjs",
    "media:audit": "node scripts/media-audit.mjs",
    "deps:check": "node scripts/check-dependency-policy.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "vite build && node scripts/copy-storefront-data.mjs",
    "build:verify": "node scripts/verify-dist.mjs",
    "preview": "vite preview",
    "quality": "npm run deps:check && npm run test && npm run lint"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "lucide": "1.31.0",
    "motion": "13.1.0",
    "p-queue": "^9.3.3",
    "sharp": "^0.35.3",
    "swiper": "14.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  }
}
