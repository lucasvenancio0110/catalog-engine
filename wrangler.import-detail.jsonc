{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catalog-engine-import-detail",
  "main": "./worker/import-detail-entry.js",
  "compatibility_date": "2026-08-17",
  "workers_dev": false,
  "vars": {
    "CLOUDFLARE_PLATFORM_DISPATCH_NAMESPACE": "catalog-engine-production"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "catalog-engine-db",
      "database_id": "12ac414c-4aef-4668-a8f9-dc63d57d449f",
      "migrations_dir": "migrations"
    }
  ],
  "dispatch_namespaces": [
    {
      "binding": "TENANT_DISPATCH",
      "namespace": "catalog-engine-production"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "catalog-engine-import-detail",
        "max_batch_size": 4,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "catalog-engine-import-detail-dlq",
        "max_concurrency": 2,
        "retry_delay": 120
      }
    ]
  }
}
