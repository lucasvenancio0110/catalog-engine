{
  "name": "catalog-engine-import-detail",
  "main": "./worker/import-detail-entry.js",
  "compatibility_date": "2024-11-01",
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "CATALOG_DB",
      "database_name": "catalog-engine-db",
      "database_id": "da848315-1184-454f-9d76-b8c9c2f38976"
    }
  ],
  "dispatch_namespaces": [
    {
      "binding": "TENANT_DISPATCH",
      "namespace": "catalog-engine-production"
    }
  ],
  "queues": {
    "producers": [],
    "consumers": [
      {
        "queue": "catalog-engine-import-detail",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "catalog-engine-import-detail-dlq",
        "max_concurrency": 4,
        "retry_delay": 120
      }
    ]
  }
}
